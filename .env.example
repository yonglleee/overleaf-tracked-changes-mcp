# Local folder used for project-wide read/search context.
OVERLEAF_MCP_LOCAL_ROOT=C:\path\to\overleaf\project

# Chrome/Edge launched with remote debugging, already logged into Overleaf.
# Example:
# chrome.exe --remote-debugging-port=9222 --user-data-dir=C:\temp\overleaf-mcp-profile
OVERLEAF_BROWSER_CDP=http://127.0.0.1:9222

# Optional default project URL opened when no Overleaf tab exists.
OVERLEAF_PROJECT_URL=https://www.overleaf.com/project/<project-id>