{
  "name": "overleaf-tracked-changes-mcp",
  "version": "0.1.0",
  "description": "MCP server for safe paragraph-scale Overleaf edits through tracked browser changes.",
  "type": "module",
  "bin": {
    "overleaf-tracked-changes-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
