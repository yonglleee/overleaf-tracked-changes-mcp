    "@modelcontextprotocol/sdk": "^1.17.0",
    "playwright": "^1.54.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0"
  }
}